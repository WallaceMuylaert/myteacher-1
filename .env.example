SECRET_KEY=your-secret-key-here-change-in-production-please-use-a-strong-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

PORT_BACKEND=8501
PORT_FRONTEND=5273

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Para produção com nginx proxy, use /api
# Para desenvolvimento local, use http://localhost:8501 (ou /api se via proxy)
VITE_API_URL=/api

# Stripe (sobrescreve o que estiver em Configurações do admin)
# Produção: chaves sk_live_ / whsec_ do endpoint live e prices criados no modo live.
# Este arquivo é versionado: nunca cole chaves aqui, só no .env (ignorado pelo git).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price de fallback, usado só em checkout sem plano selecionado
STRIPE_PRICE_ID=
# Prices por plano (sincronizados no boot em backend/core/init_db.py)
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=

# URL pública do frontend, usada no retorno do Checkout e no OAuth do Google.
FRONTEND_URL=http://localhost:5273
VITE_SUPPORT_WHATSAPP_NUMBER=5521994152560

# Google OAuth e Google Agenda (Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8501/auth/google/callback
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
# Endpoints do Google (opcional - defaults padrões já configurados)
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo
# GOOGLE_CALENDAR_API_URL=https://www.googleapis.com/calendar/v3/calendars/primary/events
# GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/calendar.events
